# Paste your Finnhub API key after the equals sign.
# Leave it blank to run the app without live prices or news.
# Never put the key in a code file. This file is only an example.
FINNHUB_API_KEY=

# Optional. Leave blank to fetch live prices and news whenever a key is set.
# Set to 0 to force offline mode even if FINNHUB_API_KEY is filled in.
FUN_D_FINNHUB_LIVE=

# Optional. Leave blank to use the local SQLite database.
# A later version can point this at PostgreSQL without changing the app code.
# DATABASE_URL=sqlite:///./fund.db

# Optional. SEC asks for a User-Agent with an app name and a contact email.
# Leave it blank to skip 8-K caching. Example placeholder only, not a real address:
# SEC_USER_AGENT=fun(d) contact@example.com
SEC_USER_AGENT=

# Optional. Comma-separated origins allowed to call this API.
# Leave blank to allow any origin. This app has no cookies or login.
# The website uses the Vite /api proxy and does not need a value here.
CORS_ORIGINS=
